# Copy this file to .env before running docker compose.

# Public web port for the one-container-facing app.
APP_PORT=8080

# Optional GitHub and LLM credentials.
GITHUB_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL_STRONG=gpt-4.1
LLM_MODEL_MULTIMODAL=gpt-4.1

# SQLite is persisted in the backend-data Docker volume by default.
DATABASE_URL=sqlite:////data/ai_pr_review.db

